# Docker context & temp build
**/.docker/
.docker/
docker/  
docker-compose-debug.yml
docker-compose.release.yml

# Ignore intermediate Docker layers
**/Dockerfile.*.tmp

# Local environment variables (DO NOT COMMIT)
.env
.env.development
.env.local
.env.*.local

